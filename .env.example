# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time, so they are
# readable by anyone with the app. Only ever put publishable values here.
# The Supabase anon key is designed for this (it is gated by Row Level
# Security); the service role key is NOT and must never appear in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- server-side only, NOT for this file ---
# SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY are set as Supabase Edge
# Function secrets (`supabase secrets set ...`), never bundled into the app.
# See docs/tripvault-setup-steps.md.
