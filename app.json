{
  "expo": {
    "name": "TripVault",
    "slug": "tripvault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tripvault.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tripvault.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "TripVault uses the camera to scan your passport or ID. The scan is read on your device and never sent anywhere for processing."
        }
      ]
    ],
    "scheme": "tripvault",
    "owner": "blackbirdzz-property",
    "extra": {
      "eas": {
        "projectId": "198e68de-c4f6-470b-a910-a64f25d70fc2"
      }
    }
  }
}
